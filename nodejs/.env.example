# ---- GSF TradeHub -----------------------------------------------------------
GSF_BASE_URL=https://trade.gsfcarparts.com

# Credentials for the NextAuth "credentials" provider.
# Use a secret manager in production. Do NOT commit real values.
GSF_EMAIL=
GSF_PASSWORD=

# Login form field name for the username. Default "email".
# Confirm from DevTools: sign in with the Network tab open and read the form
# body of POST /api/auth/callback/credentials. If it says "username", set that.
GSF_USER_FIELD=email

# Optional. Leave blank and it is read from the live session.
GSF_ACCOUNT_NO=

# Present as a browser — DataDome sits at the edge.
# GSF_USER_AGENT="Mozilla/5.0 ..."

GSF_TIMEOUT=60
GSF_COOKIE_TTL=1209600        # 14 days
GSF_MENUS_TTL=2592000         # 30 days
GSF_PARTS_TTL=600             # 10 min; 0 = always live. Contains stock levels.
GSF_PREFER=availability       # or: price
GSF_ALERT_EMAIL=

# ---- Node-specific -----------------------------------------------------------
# Encrypts the cached cookie jar at rest. Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GSF_APP_KEY=

# Cache store. Unset = file cache in nodejs/.cache (fine for one server).
# Set this in production: with a per-process cache every worker logs in separately.
# REDIS_URL=redis://127.0.0.1:6379

# ---- Emailing quotation PDFs to customers (optional) --------------------
# Until one way is set up, the "Email PDF" button is disabled. If both are
# set, Microsoft Graph is used.
#
# Microsoft Graph (preferred for Microsoft 365): an Entra app registration
# with the Mail.Send application permission. MAIL_FROM is the mailbox it sends as.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
#
# SMTP: port 465 uses TLS from the start; 587 upgrades with STARTTLS.
# Microsoft 365 turns SMTP AUTH off by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Auto Assist Group <info@autoassistgroup.com>"
# Optional: a copy of every quotation sent
MAIL_BCC=
