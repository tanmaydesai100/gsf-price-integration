# JLR EPC credentials - keep this file as a template only.
# Copy values into nodejs/.env, which must remain gitignored.
JLR_EPC_EMAIL=
JLR_EPC_PASSWORD=
# The sponsoring retailer's partner code (sent as retailer code and ID).
# jlrepc.com -> DevTools -> Session storage -> customerSessionItem -> customerRetailerID
JLR_RETAILER_CODE=

# Encrypts the cached JLR session. Falls back to GSF_APP_KEY if unset.
JLR_APP_KEY=

# Markup on the JLR unitPrice, in percent. Default 0: JLR parts are quoted at
# the catalogue price. Does not fall back to GSF_MARKUP_PERCENT.
JLR_MARKUP_PERCENT=

# Catalogue tree walk: pause between requests, and a hard cap on nodes.
JLR_WALK_DELAY_MS=250
JLR_MAX_NODES=1500

# Cache lifetimes, in seconds. JLR_PARTS_TTL=0 always fetches live prices.
JLR_VEHICLE_TTL=2592000
JLR_TREE_TTL=2592000
JLR_PARTS_TTL=600

JLR_TIMEOUT=60

# Login endpoints default to the values read from the live site on
# 2026-09-24 (see jlr/src/config.js). Override only if JLR changes them:
# JLR_EPC_BASE_URL, JLR_SLAS_ORG_ID, JLR_SLAS_CLIENT_ID, JLR_SLAS_SITE_ID,
# JLR_SLAS_HINT, JLR_AUTH_BASE_URL, JLR_AUTH_REALM, JLR_AUTH_TREE
