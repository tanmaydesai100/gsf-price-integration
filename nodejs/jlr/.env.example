# JLR EPC credentials - keep this file as a template only.
# Copy values into nodejs/.env, which must remain gitignored.
JLR_EPC_BASE_URL=https://www.jlrepc.com
JLR_EPC_EMAIL=
JLR_EPC_PASSWORD=
JLR_RETAILER_CODE=
JLR_RETAILER_ID=

JLR_AUTH_BASE_URL=https://enterprise.jaguarlandrover.com/business/auth
JLR_AUTH_REALM=enterprise
JLR_AUTH_TREE=iepc-login
JLR_PROFILE_DIR=jlr/.jlr-profile
JLR_BROWSER_HEADLESS=false
JLR_LOGIN_TIMEOUT=120

# Optional current authenticated session values.
# Leave these blank when automatic ForgeRock login is available.
JLR_SESSION_COOKIE=
JLR_APIGEE_TOKEN=

JLR_TIMEOUT=60
